# OCD Live & Shop — variables d'environnement locales
# Copiez ce fichier en `.env` avant de lancer `npm run db:push` :
#   - Linux / macOS :  cp .env.example .env
#   - Windows (PowerShell) :  Copy-Item .env.example .env

# Base SQLite locale — le fichier prisma/dev.db est créé par `npm run db:push`
DATABASE_URL="file:./dev.db"

# Production (Neon / Railway / Render / VPS PostgreSQL) : remplacez la ligne
# ci-dessus par l'URL fournie (postgresql://...) et basculez le provider du
# schéma Prisma vers "postgresql" — voir DEPLOIEMENT.md § 2.
