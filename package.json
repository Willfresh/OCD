    "@types/react-dom": "^19",
    "dotenv": "^16.4.5",
    "prisma": "^6.11.1",
    "tailwindcss": "^4",
    "tailwindcss-animate": "^1.0.7",
    "tsx": "^4.19.0",
    "tw-animate-css": "^1.3.5",
    "typescript": "^5"
